# Frontend public environment variables (Vite)
# NEVER put backend secrets such as TURNSTILE_SECRET_KEY or IP_HASH_SALT here.

# Cloudflare Turnstile Site Key (public).
# For local development, you can use Cloudflare's dummy test key:
# Always passes: 1x00000000000000000000AA
# Always blocks: 2x00000000000000000000AB
VITE_TURNSTILE_SITE_KEY=

# Optional Turnstile action name.
# Leave unset unless TURNSTILE_EXPECTED_ACTION is also configured on the Worker.
# When set, both frontend and backend values must match exactly.
# VITE_TURNSTILE_ACTION=contact_form
